// Install as /etc/polkit-1/rules.d/60-gitea-replication.rules
// Permit the dedicated Gitea account to manage gitea.service and to invoke
// the fixed-path, root-owned atomic data exchange helper.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "gitea.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.user == "git") {
        return polkit.Result.YES;
    }

    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "gitea-replication-switch.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "git") {
        return polkit.Result.YES;
    }
});
